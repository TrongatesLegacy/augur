{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Augur",
  "version": "0.1.14",
  "identifier": "com.trongateslegacy.augur",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Augur",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 576,
        "center": true,
        "visible": false,
        "backgroundColor": "#0d0b16",
        "theme": "Dark"
      },
      {
        "label": "tray",
        "title": "Augur",
        "url": "tray.html",
        "width": 340,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Calls PalDuels fights before the bell",
    "longDescription": "Augur predicts PalDuels fights from stats, types, moves and history, and keeps score.",
    "copyright": "TrongatesLegacy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NEQzOTIzMjFENTAxQjEKUldTeEFkVWhJemxOZVF3U0NlWE01MUdZcU8vNTN3R3VsRm1tb0Z4aEF4NDFpK1F2clZpeHBicnAK",
      "endpoints": [
        "https://github.com/TrongatesLegacy/augur/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
