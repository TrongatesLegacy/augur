# The same basics in every editor. Rust formatting itself is rustfmt's (rustfmt.toml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 140

[*.md]
trim_trailing_whitespace = false

[engine/tests/pages/**]
# saved palduels.com pages, kept byte for byte
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
